# ============================================================
# Medical Imaging System — Variables de entorno (Dokploy)
# ============================================================
# Copia este archivo a .env en Dokploy y rellena cada valor.
#
# Arquitectura:
#   - 'web'    → único servicio público (nginx SPA + proxy reverso)
#   - 'server' → Node/Hono: Better-Auth + proxy hacia Python API
#   - 'api'    → Python/FastAPI: lógica de negocio + YOLO + Gemini
#   - 'redis'  → broker de Celery y cache
#   - 'seaweedfs' → almacenamiento S3-compatible de imágenes DICOM
#   - 'imgproxy'  → procesamiento y firma de imágenes


# ============================================================
# 1. DOMINIO PÚBLICO
# ============================================================
# URL pública asignada al servicio 'web' en Dokploy (Traefik).
# Se usa como base para Better-Auth y CORS.
# Formato: https://tu-dominio.com  (sin barra final)
APP_URL=https://medical.tudominio.com


# ============================================================
# 2. BASE DE DATOS — PostgreSQL externo
# ============================================================
# Ambas URLs deben apuntar a la MISMA base de datos Postgres.
# Dokploy las provee por separado según el driver.

# URL SYNC — usada por Alembic (migraciones Python) y Drizzle (schema Node).
# Driver: psycopg2  →  postgresql://
DATABASE_URL=postgresql://usuario:contraseña@host:5432/medical_system

# URL ASYNC — usada por FastAPI/SQLAlchemy en runtime.
# Driver: asyncpg  →  postgresql+asyncpg://
ASYNC_DATABASE_URL=postgresql+asyncpg://usuario:contraseña@host:5432/medical_system


# ============================================================
# 3. AUTENTICACIÓN — Better-Auth (servicio 'server')
# ============================================================
# Secreto de sesión: MÍNIMO 32 caracteres aleatorios.
# Generar con:  openssl rand -base64 32
BETTER_AUTH_SECRET=cambia_esto_por_un_secreto_de_minimo_32_caracteres


# ============================================================
# 4. IA — Google Gemini (servicio 'api')
# ============================================================
# Clave de API para la generación de informes radiológicos con Gemini.
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini


# ============================================================
# 5. ALMACENAMIENTO — imgproxy (firma de imágenes)
# ============================================================
# Clave y salt para firmar URLs de imgproxy (hex de 32+ bytes).
# Generar con:  openssl rand -hex 32
IMGPROXY_KEY=73757065722d7365637265742d6b6579
IMGPROXY_SALT=73757065722d7365637265742d73616c74
