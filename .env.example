# ==========================================
# Configuración del Sistema Médico (Dokploy)
# ==========================================

# ------------------------------------------
# 1. Base de Datos (PostgreSQL Compartido)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=una_contraseña_muy_segura_aqui
POSTGRES_DB=postgres

# ------------------------------------------
# 2. Servidor de Autenticación (Node / Auth)
# ------------------------------------------
# La URL de la BD para el servidor debe apuntar a la base de datos 'server_db' que crea el init-dbs.sql
DATABASE_URL=postgresql://postgres:una_contraseña_muy_segura_aqui@db:5432/server_db
# Generar un string aleatorio largo (ej. openssl rand -base64 32)
BETTER_AUTH_SECRET=super_secret_auth_key_change_me_in_prod
# URL pública donde vive el servidor de autenticación (ej: https://auth.tudominio.com)
BETTER_AUTH_URL=http://localhost:3000
# URL del frontend — usada para la política CORS del servidor de auth
CORS_ORIGIN=https://tudominio.com

# ------------------------------------------
# 3. API de Inteligencia Artificial (Python)
# ------------------------------------------
# La URL de la BD para la API debe apuntar a 'api_db'
SQL_DATABASE_URL=postgresql://postgres:una_contraseña_muy_segura_aqui@db:5432/api_db
ASYNC_SQL_DATABASE_URL=postgresql+asyncpg://postgres:una_contraseña_muy_segura_aqui@db:5432/api_db
# URL interna del servidor de autenticación (para validar sesiones)
SERVER_URL=http://server:3000
# Modelo de IA (asegúrate de que el archivo exista en apps/api/models/)
YOLO_MODEL_PATH=models/yolo_resonancia.pt

# ------------------------------------------
# 4. Frontend Web (Vite)
# ------------------------------------------
# Vite hornea estas variables en el bundle estático al ejecutar 'pnpm build'.
# Deben inyectarse como BUILD ARGS en Dokploy (no como env vars de runtime).
# Los defaults /api y /server funcionan con el proxy nginx incluido en el contenedor web.
VITE_PYTHON_API_URL=/api
VITE_SERVER_URL=/server
