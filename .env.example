# ==========================================
# Sistema Médico — Variables de entorno (Dokploy)
# ==========================================
# Copia este archivo a .env y rellena los valores marcados.
#
# Arquitectura de DOMINIO ÚNICO:
#   - Solo el servicio 'web' es público. En Dokploy asígnale UN dominio (= APP_URL).
#   - 'web' (nginx) hace de proxy interno: /api -> server (auth + recursos), /imgproxy -> imgproxy.
#   - El frontend usa rutas relativas al mismo origen, así que NO hay que configurar más dominios.

# ------------------------------------------
# 1. Dominio público único
# ------------------------------------------
# URL pública de la app = dominio que asignas al servicio 'web' en Dokploy.
# Se usa para Better-Auth (baseURL) y para la política de orígenes de confianza.
APP_URL=https://medical.tudominio.com

# ------------------------------------------
# 2. Base de datos (PostgreSQL externo, compartido)
# ------------------------------------------
# URL ÚNICA para toda la plataforma. DEBE ser un postgresql:// plano (sin +asyncpg):
#   - el server (Drizzle / Better-Auth) la usa tal cual
#   - la API (Python) deriva sola la versión async (postgresql+asyncpg://)
# Apunta a tu Postgres externo y a una base de datos YA CREADA.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/medical_system

# ------------------------------------------
# 3. Autenticación (Better-Auth)
# ------------------------------------------
# Secreto de sesión: MÍNIMO 32 caracteres. Genéralo con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia_esto_por_un_secreto_de_minimo_32_caracteres

# ------------------------------------------
# 4. API de IA (Python)
# ------------------------------------------
# Clave de Google Gemini para la generación de informes radiológicos.
GEMINI_API_KEY=tu_api_key_de_gemini
